{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dark West Character Sheet",
  "mainBinaryName": "DarkWest",
  "version": "1.4.1",
  "identifier": "com.stefano.darkwest",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Character Sheet",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
